#include <Servo.h>

// Crear los cuatro servomotores
Servo servo1;
Servo servo2;
Servo servo3;
Servo servo4;

// Pines de los servomotores
const int pinServo1 = 9;
const int pinServo2 = 10;
const int pinServo3 = 11;
const int pinServo4 = 12;

// Pines de los potenciometros
const int pot1 = A0;
const int pot2 = A1;
const int pot3 = A2;
const int pot4 = A3;

void setup() {

  // Asignar pines a los servomotores
  servo1.attach(pinServo1);
  servo2.attach(pinServo2);
  servo3.attach(pinServo3);
  servo4.attach(pinServo4);

  // Posicion inicial
  servo1.write(90);
  servo2.write(90);
  servo3.write(90);
  servo4.write(90);
}

void loop() {

  // Leer los cuatro potenciometros
  int valor1 = analogRead(pot1);
  int valor2 = analogRead(pot2);
  int valor3 = analogRead(pot3);
  int valor4 = analogRead(pot4);

  // Convertir lecturas a grados
  int angulo1 = map(valor1, 0, 1023, 0, 180);
  int angulo2 = map(valor2, 0, 1023, 0, 180);
  int angulo3 = map(valor3, 0, 1023, 0, 180);
  int angulo4 = map(valor4, 0, 1023, 0, 180);

  // Control independiente de cada servo
  servo1.write(angulo1);
  servo2.write(angulo2);
  servo3.write(angulo3);
  servo4.write(angulo4);

  delay(20);
}
